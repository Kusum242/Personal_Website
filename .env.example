# Copy to .env and fill values to enable email sending
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=you@yourdomain.com   # optional, defaults to SMTP_USER
TO_EMAIL=your_personal_email@example.com
PORT=3000
# Optional: serve static files from the project root so you can open http://localhost:3000 and use form without extra config
SERVE_STATIC=true
